#include <stdio.h>
#include <string.h>

struct Carta {
    char estado;
    char codigo[4];
    char cidade[50];
    int populacao;
    float area;
    float pib;
    int pontos_turisticos;
};

void mostrarCarta(struct Carta c, int numero) {
    printf("\n===== CARTA %d =====\n", numero);
    printf("Estado: %c\n", c.estado);
    printf("Codigo: %s\n", c.codigo);
    printf("Cidade: %s\n", c.cidade);
    printf("Populacao: %d habitantes\n", c.populacao);
    printf("Area: %.2f km²\n", c.area);
    printf("PIB: %.2f\n", c.pib);
    printf("Pontos Turisticos: %d\n", c.pontos_turisticos);
}

int main() {
    struct Carta carta1, carta2;

    // Entrada da Carta 1
    printf("=== Cadastro da Carta 1 ===\n");
    scanf(" %c", &carta1.estado);
    scanf("%s", carta1.codigo);
    scanf(" %[^\n]", carta1.cidade);
    scanf("%d", &carta1.populacao);
    scanf("%f", &carta1.area);
    scanf("%f", &carta1.pib);
    scanf("%d", &carta1.pontos_turisticos);

    // Entrada da Carta 2
    printf("\n=== Cadastro da Carta 2 ===\n");
    scanf(" %c", &carta2.estado);
    scanf("%s", carta2.codigo);
    scanf(" %[^\n]", carta2.cidade);
    scanf("%d", &carta2.populacao);
    scanf("%f", &carta2.area);
    scanf("%f", &carta2.pib);
    scanf("%d", &carta2.pontos_turisticos);

    // Exibição organizada
    printf("\n\n======= RESULTADOS =======\n");

    mostrarCarta(carta1, 1);
    mostrarCarta(carta2, 2);

    return 0;
}
